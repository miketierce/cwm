{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/miketierce/cwm/schemas/k_eff_frontier.schema.json",
  "title": "CWM K_eff Frontier Point",
  "type": "object",
  "required": [
    "experiment_id",
    "session_group",
    "device_id",
    "path_state",
    "simultaneous_inputs",
    "receive_channels",
    "adc_conversions",
    "acquisition_window_s",
    "k_eff_rank",
    "k_eff_task",
    "valid"
  ],
  "properties": {
    "experiment_id": {
      "type": "string"
    },
    "session_group": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "path_state": {
      "type": "string"
    },
    "simultaneous_inputs": {
      "type": "integer",
      "minimum": 1
    },
    "readout_features": {
      "type": "integer",
      "minimum": 0
    },
    "receive_channels": {
      "type": "integer",
      "minimum": 0
    },
    "adc_conversions": {
      "type": "integer",
      "minimum": 0
    },
    "acquisition_window_s": {
      "type": "number",
      "minimum": 0
    },
    "digital_ops": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "calibration_bytes": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "calibration_trials": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "system_energy_j": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "k_eff_rank": {
      "type": "number",
      "minimum": 0
    },
    "k_eff_task": {
      "type": "number",
      "minimum": 0
    },
    "heldout_metric": {
      "type": [
        "string",
        "null"
      ]
    },
    "heldout_metric_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "electrical_control_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "valid": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    },
    "controlled_paths": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "possible_pairwise_terms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "supported_interaction_terms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "relational_tasks_attempted": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "relational_tasks_passed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "best_relational_balanced_accuracy": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "coherent_model_nrmse": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "held_model_r2": {
      "type": [
        "number",
        "null"
      ]
    },
    "digital_ops_after_capture": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  },
  "additionalProperties": true
}
