{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/miketierce/cwm/schemas/phonon_gate_manifest.schema.json",
  "title": "CWM Phonon Gate Session Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "timestamp_utc",
    "git_commit",
    "operator",
    "device",
    "acquisition",
    "reference_channel",
    "queries",
    "controls",
    "preregistration"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "session_id": {"type": "string", "minLength": 1},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "git_commit": {"type": "string", "minLength": 7},
    "operator": {"type": "string", "minLength": 1},
    "random_seed": {"type": "integer"},
    "device": {
      "type": "object",
      "required": ["device_id", "geometry_id", "material", "tx_pzt_id", "rx_pzt_id", "fixture_id"],
      "properties": {
        "device_id": {"type": "string"},
        "geometry_id": {"type": "string"},
        "material": {"type": "string"},
        "dimensions_mm": {"type": "array", "items": {"type": "number"}, "minItems": 2},
        "tx_pzt_id": {"type": "string"},
        "rx_pzt_id": {"type": "string"},
        "tx_position": {"type": "string"},
        "rx_position": {"type": "string"},
        "fixture_id": {"type": "string"},
        "mount_notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "acquisition": {
      "type": "object",
      "required": ["scope_model", "sample_rate_hz", "samples_per_channel", "ch_a_range", "ch_b_range"],
      "properties": {
        "scope_model": {"type": "string"},
        "sample_rate_hz": {"type": "number", "exclusiveMinimum": 0},
        "samples_per_channel": {"type": "integer", "minimum": 1},
        "ch_a_range": {"type": "string"},
        "ch_b_range": {"type": "string"},
        "preamp": {"type": "string"},
        "drive_buffer": {"type": "string"},
        "environment_sensor": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "reference_channel": {
      "type": "object",
      "required": ["enabled", "description"],
      "properties": {
        "enabled": {"type": "boolean"},
        "description": {"type": "string"},
        "ratio_definition": {"type": "string", "default": "H=Za/Zb"}
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["query_id", "waveform_type"],
        "properties": {
          "query_id": {"type": "string"},
          "waveform_type": {"enum": ["single_tone", "multitone", "arbitrary", "temporal"]},
          "frequencies_hz": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}},
          "relative_phases_rad": {"type": "array", "items": {"type": "number"}},
          "commanded_rms": {"type": ["number", "null"]},
          "duration_s": {"type": ["number", "null"]},
          "notes": {"type": "string"}
        }
      }
    },
    "controls": {
      "type": "object",
      "required": ["quiet", "loopback", "electrical_only"],
      "properties": {
        "quiet": {"type": "string"},
        "loopback": {"type": "string"},
        "electrical_only": {"type": "string"},
        "reassembled": {"type": ["string", "null"]}
      }
    },
    "preregistration": {
      "type": "object",
      "required": ["training_sessions", "heldout_sessions", "primary_metric", "success_rule"],
      "properties": {
        "training_sessions": {"type": "array", "items": {"type": "string"}},
        "heldout_sessions": {"type": "array", "items": {"type": "string"}},
        "primary_metric": {"type": "string"},
        "success_rule": {"type": "string"},
        "unknown_policy": {"type": "string"},
        "normalization_policy": {"type": "string"}
      }
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
